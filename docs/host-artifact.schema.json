{
  "$defs": {
    "DataNature": {
      "enum": [
        "real",
        "synthetic",
        "mixed",
        "none"
      ],
      "type": "string"
    },
    "ExecutionMaterials": {
      "additionalProperties": false,
      "description": "Paths name declared files relative to the frozen package, never a session directory.\nThese declarations preserve materials; they do not certify that a computation was rerun.",
      "properties": {
        "data": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "entrypoint": {
          "type": "string"
        },
        "environment": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "instructions": {
          "type": "string"
        },
        "parameters": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "entrypoint",
        "parameters",
        "environment",
        "data",
        "evidence",
        "instructions"
      ],
      "type": "object"
    },
    "PublicationFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "media_type": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "role",
        "media_type",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "PublicationKind": {
      "enum": [
        "study",
        "strategy",
        "run",
        "series"
      ],
      "type": "string"
    },
    "PublicationOrigin": {
      "enum": [
        "project",
        "imported",
        "example"
      ],
      "type": "string"
    },
    "PublicationRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/PublicationKind"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "body": {
      "type": "string"
    },
    "cover": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_nature": {
      "$ref": "#/$defs/DataNature"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionMaterials"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PublicationFile"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/PublicationKind"
    },
    "origin": {
      "$ref": "#/$defs/PublicationOrigin"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#/$defs/PublicationRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_format": {
      "type": "string"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/PublicationRef"
      },
      "type": "array"
    },
    "request_id": {
      "type": "string"
    },
    "revision_note": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "search": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "request_id",
    "kind",
    "title",
    "summary",
    "origin",
    "data_nature",
    "body",
    "search",
    "revision_note",
    "references",
    "project_format",
    "files"
  ],
  "title": "PublicationPackage",
  "type": "object"
}
